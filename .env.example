CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# Optional. High-priority checkbox looks up this id in GET /v1/models and copies a High variant.
CURSOR_HIGH_PRIORITY_MODEL=grok-4.6

# Optional. Clone this GitHub repo into the cloud VM so the agent can also read profile/.
# Requires source control connected in Cursor. Leave blank for a no-repo cloud agent
# (profile files are still injected into the prompt from this machine).
CURSOR_CLOUD_REPO_URL=
CURSOR_CLOUD_REPO_REF=main
